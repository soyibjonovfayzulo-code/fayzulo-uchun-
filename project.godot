"type": "vec4",
"value": Vector4(-10000, -10000, 10000, 10000)
}
cut_box_on={
"type": "float",
"value": 0.0
}
wind={
"type": "float",
"value": 0.4
}
rain_wet={
"type": "float",
"value": 0.0
}
night_factor={
"type": "float",
"value": 0.0
}
