; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Russian Zombie Survival"
config/description="Isometric survival prototype set in a post-Soviet residential district."
run/main_scene="res://launcher/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/menu_bg.png"

[autoload]

V04Events="*res://versions/v04/scripts/systems/events.gd"
V04GameTime="*res://versions/v04/scripts/systems/game_time.gd"
V04NoiseSystem="*res://versions/v04/scripts/systems/noise.gd"
V04Sfx="*res://versions/v04/scripts/systems/sfx.gd"
V04ItemDB="*res://versions/v04/scripts/systems/item_db.gd"
V04Settings="*res://versions/v04/scripts/systems/game_settings.gd"
V03Events="*res://versions/v03/scripts/systems/events.gd"
V03GameTime="*res://versions/v03/scripts/systems/game_time.gd"
V03NoiseSystem="*res://versions/v03/scripts/systems/noise.gd"
V03Sfx="*res://versions/v03/scripts/systems/sfx.gd"
V03ItemDB="*res://versions/v03/scripts/systems/item_db.gd"
V03Settings="*res://versions/v03/scripts/systems/game_settings.gd"
V02Events="*res://versions/v02/scripts/systems/events.gd"
