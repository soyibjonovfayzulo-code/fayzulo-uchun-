[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="zombies"
3d_physics/layer_4="interact"
3d_physics/layer_5="items"
3d_physics/layer_6="doors"

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
textures/decals/filter=0
environment/defaults/default_clear_color=Color(0.07, 0.075, 0.08, 1)
textures/vram_compression/import_etc2_astc=true

[shader_globals]

cut_player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
