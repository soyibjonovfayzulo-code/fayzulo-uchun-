ItemDB="*res://scripts/systems/item_db.gd"
Settings="*res://scripts/systems/game_settings.gd"
HotUpdate="*res://scripts/systems/hot_update.gd"
LiveDebug="*res://scripts/systems/live_debug.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

